<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Thêm User</title><style>body{font-family:Arial;max-width:650px;margin:35px auto}.field{margin:14px 0}input{box-sizing:border-box;width:100%;padding:10px;border:1px solid #bbb;border-radius:5px}button,a{background:#1769aa;color:white;padding:10px 14px;border:0;border-radius:5px;text-decoration:none;cursor:pointer}</style></head><body><h1>Thêm User</h1><form method="post" action="${pageContext.request.contextPath}/users"><input type="hidden" name="action" value="insert"><div class="field">Họ tên<input name="name" required maxlength="120"></div><div class="field">Email<input type="email" name="email" required maxlength="120"></div><div class="field">Quốc gia<input name="country" required maxlength="80"></div><button type="submit">Lưu thông tin</button> <a href="${pageContext.request.contextPath}/users">Quay lại</a></form></body></html>