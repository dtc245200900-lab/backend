<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Sửa User</title><style>body{font-family:Arial;max-width:650px;margin:35px auto}.field{margin:14px 0}input{box-sizing:border-box;width:100%;padding:10px}button,a{background:#1769aa;color:white;padding:10px 14px;border:0;border-radius:5px;text-decoration:none}</style></head><body><h1>Sửa User #${user.id}</h1><form method="post" action="${pageContext.request.contextPath}/users"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="${user.id}"><div class="field">Họ tên<input name="name" value="${user.name}" required></div><div class="field">Email<input type="email" name="email" value="${user.email}" required></div><div class="field">Quốc gia<input name="country" value="${user.country}" required></div><button>Cập nhật</button> <a href="${pageContext.request.contextPath}/users">Quay lại</a></form></body></html>